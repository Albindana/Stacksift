         Microsoft.Extensions.Hosting before its 10.0.9 dependencies, so the
         float broke restore (NU1103). 10.0.8 is the last consistent release. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StackSift.Infrastructure\StackSift.Infrastructure.csproj" />
  </ItemGroup>

</Project>
