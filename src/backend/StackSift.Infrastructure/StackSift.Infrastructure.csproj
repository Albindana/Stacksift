<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StackSift.Application\StackSift.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.*" />
    <PackageReference Include="MediatR" Version="14.3.0" />
    <PackageReference Include="OpenAI" Version="2.*" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.*" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.*" />
    <PackageReference Include="Polly" Version="8.9.1" />
    <PackageReference Include="StackExchange.Redis" Version="2.13.23" />
    <PackageReference Include="Stripe.net" Version="51.2.0" />
    <PackageReference Include="Unleash.Client" Version="6.2.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Suppress the SDK's implicit `**/*.resx` include — we have no .resx
         files and SDK 10.0.100+ errors on the empty glob in Release publishes. -->
    <EmbeddedResource Remove="**/*.resx" />
    <EmbeddedResource Include="Email\Templates\ImmediateAlert.html" />
    <EmbeddedResource Include="Email\Templates\DailyDigest.html" />
    <EmbeddedResource Include="Email\Templates\MemberAdded.html" />
    <EmbeddedResource Include="Email\Templates\Invitation.html" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
